# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# yarn.lock is the only lockfile (CI and Docker use yarn)
package-lock.json

# testing
/coverage


/.idea/
/.vscode/
# next.js
/.next/
# generated by `next dev`
/AGENTS.md
/.cursor/
/out/
/.kilo/
/.qodo/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local
# Keep .env.example as a template
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
