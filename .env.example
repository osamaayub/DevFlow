# Required by NextAuth. Generate a secure value with `npx auth secret`.
AUTH_SECRET=replace-with-a-generated-secret

# Public HTTPS origin used for canonical URLs, OAuth callbacks, robots.txt, and sitemap.xml.
# Keep this value without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://dev-flow-kappa-seven.vercel.app

# Optional Auth.js override. On Vercel, set this to the same public origin.
NEXTAUTH_URL=https://dev-flow-kappa-seven.vercel.app

# Optional MongoDB override; defaults to the MongoDB service in Compose.
# For production, set this to a secured MongoDB connection string.
MONGODB_URI=

# Optional OAuth providers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are also accepted as aliases.

# Optional AI answers
OPENAI_API_KEY=

# Optional logging configuration
LOG_LEVEL=info
